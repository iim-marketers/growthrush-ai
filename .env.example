NEXT_PUBLIC_SITE_URL=""

# Razorpay — test keys from Dashboard → Account & Settings → API Keys.
# KEY_SECRET is server-only; never prefix it with NEXT_PUBLIC_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Webhook secret — the one you type when adding the webhook under
# Dashboard → Account & Settings → Webhooks (not the key secret above).
RAZORPAY_WEBHOOK_SECRET=


# Supabase — get the URL and anon key from the Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Supabase Postgres — Connect → Transaction pooler (port 6543). Percent-encode the password.
DATABASE_URL=

AUTH_OTP_STUB=

RESEND_API_KEY=
RESEND_FROM=